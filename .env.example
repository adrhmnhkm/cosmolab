# Salin file ini menjadi .env lalu isi nilainya.
# File .env berisi kunci rahasia: jangan dibagikan dan jangan di-commit.

# Layanan AI (format OpenAI-compatible). Minta nilainya ke admin tim.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Email untuk identitas saat mengambil data dari OpenAlex, Unpaywall, dan Crossref.
# Pakai email kantor/tim.
COSMOLAB_EMAIL=

# Opsional: kunci CORE (https://core.ac.uk/services/api) untuk mencari salinan
# paper di repositori kampus. Kosongkan kalau belum punya.
CORE_API_KEY=

# Opsional: folder data utama (dipakai kalau tidak memilih proyek klien).
COSMOLAB_ROOT=data

# Kop firma untuk dokumen klien (Word/PDF)
COSMOLAB_FIRM_NAME=CosmoLab Research
COSMOLAB_FIRM_TAGLINE=Layanan Riset Multidisipliner
COSMOLAB_FIRM_ADDRESS=
# Contoh: email@firma.id | +62 812 0000 0000 | firma.id
COSMOLAB_FIRM_CONTACT=
# Opsional: path ke logo PNG/JPG, misalnya branding/logo.png
COSMOLAB_FIRM_LOGO=

# Harga model AI per 1 juta token, untuk menghitung biaya per proyek klien.
# Format: model:harga_input:harga_output;model2:harga_input:harga_output
# Isi sesuai tarif penyedia AI Anda.
COSMOLAB_PRICING=
COSMOLAB_PRICING_CURRENCY=IDR

# Password dashboard untuk mode tim (cosmolab ui --team). Minimal 10 karakter.
# Bagikan hanya ke anggota tim, lewat jalur yang aman.
COSMOLAB_TEAM_PASSWORD=
